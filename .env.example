# ==========================================
# PHARMA-TRACEABILITY ENVIRONMENT CONFIGURATION
# ==========================================

# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:19006

# Security & Authentication
JWT_SECRET=super_secure_jwt_secret_change_in_production_min_32_characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secure_refresh_token_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharma_traceability_db
DB_USER=pharma_admin
DB_PASSWORD=pharma_secure_password_123
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin_user
MINIO_SECRET_KEY=minio_secure_password_123
MINIO_BUCKET_NAME=pharma-documents

# Hyperledger Fabric Configuration
FABRIC_CHANNEL_NAME=pharmachannel
FABRIC_CHAINCODE_NAME=pharma-contract
FABRIC_MSP_ID_ORG1=ManufacturerMSP
FABRIC_MSP_ID_ORG2=DistributorMSP
FABRIC_PEER_ENDPOINT_ORG1=localhost:7051
FABRIC_PEER_ENDPOINT_ORG2=localhost:9051
FABRIC_CRYPTO_PATH=../../blockchain/network/organizations
FABRIC_CONNECTION_PROFILE_PATH=../../blockchain/gateway/connection-profiles/connection-org1-manufacturer.json
FABRIC_AS_LOCALHOST=true

# Verification & Anomaly Detection Engine
VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
VERIFICATION_RATE_LIMIT_MAX=100
ANOMALY_GEO_DISTANCE_KM_THRESHOLD=500
ANOMALY_TIME_WINDOW_MINUTES_THRESHOLD=30
